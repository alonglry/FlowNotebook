# FlowNotebook Frontend Environment Configuration

# Optional: Google Drive Cloud Storage & Authentication
# Obtain these from Google Cloud Console (APIs & Services -> Credentials -> OAuth 2.0 Client ID)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=

# Optional: Custom Backend WebSocket URL (Defaults to auto-detecting current host :8000)
# VITE_BACKEND_WS_URL=wss://your-backend-url.onrender.com/ws/execute
